    <script>
        document.addEventListener('DOMContentLoaded', () => {
            
            const form = document.getElementById('ai-inventory-form');
            const stepsContainer = document.getElementById('form-steps-container');
            const steps = Array.from(stepsContainer.getElementsByClassName('form-step'));
            const nextBtn = document.getElementById('next-btn');
            const prevBtn = document.getElementById('prev-btn');
            const loadingSpinner = document.getElementById('loading-spinner');
            const resultsDiv = document.getElementById('assessment-results');
            const assessmentContainer = document.getElementById('assessment-container');
            const mobileMenuBtn = document.getElementById('mobile-menu-btn');
            const mobileMenu = document.getElementById('mobile-menu');

            let currentStep = 0;
            const totalSteps = steps.length;

            const showStep = (stepIndex) => {
                steps.forEach((step, index) => {
                    step.classList.toggle('active', index === stepIndex);
                });

                prevBtn.classList.toggle('hidden', stepIndex === 0);
                
                if (stepIndex === totalSteps - 1) {
                    nextBtn.textContent = 'Get My Report →';
                } else {
                    nextBtn.textContent = 'Next →';
                }
            };

            const validateStep = (stepIndex) => {
                const currentStepElement = steps[stepIndex];
                const inputs = currentStepElement.querySelectorAll('input[type="radio"], input[type="checkbox"]');
                if (inputs.length > 0) {
                    const isChecked = Array.from(inputs).some(input => input.checked);
                    if (!isChecked) {
                        const firstInput = inputs[0];
                        if (firstInput) {
                            firstInput.focus();
                        }
                        return false;
                    }
                }
                return true;
            };
            
            nextBtn.addEventListener('click', () => {
                if (!validateStep(currentStep)) {
                    const errorMsg = document.createElement('p');
                    errorMsg.textContent = 'Please select an option to continue.';
                    errorMsg.className = 'text-red-500 text-sm mt-2';
                    const existingError = steps[currentStep].querySelector('.text-red-500');
                    if (!existingError) {
                        steps[currentStep].appendChild(errorMsg);
                    }
                    return;
                }
                
                const existingError = steps[currentStep].querySelector('.text-red-500');
                if (existingError) {
                    existingError.remove();
                }

                if (currentStep < totalSteps - 1) {
                    currentStep++;
                    showStep(currentStep);
                } else {
                    handleFormSubmit();
                }
            });

            prevBtn.addEventListener('click', () => {
                if (currentStep > 0) {
                    currentStep--;
                    showStep(currentStep);
                }
            });

            const handleFormSubmit = () => {
                const formData = new FormData(form);
                const answers = Object.fromEntries(formData.entries());

                const userQuery = `
                    A potential client has answered 7 questions about their organization's AI readiness. 
                    Here are their answers:
                    1. Primary Goal: ${answers.goal || 'Not specified'}
                    2. Team Knowledge: ${answers.knowledge || 'Not specified'}
                    3. Data Availability: ${answers.data || 'Not specified'}
                    4. Governance: ${answers.governance || 'Not specified'}
                    5. Biggest Challenge: ${answers.challenge || 'Not specified'}
                    6. AI Champion: ${answers.champion || 'Not specified'}
                    7. Ideal Timeline: ${answers.timeline || 'Not specified'}
                `;

                callGemini(userQuery);
            };

            const callGemini = async (prompt) => {
                form.classList.add('hidden');
                loadingSpinner.classList.remove('hidden');
                resultsDiv.classList.add('hidden');

                const apiKey = ""; 
                const apiUrl = `https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash-preview-09-2025:generateContent?key=${apiKey}`;
                
                const systemPrompt = `You are an expert AI adoption consultant. A potential client has provided answers from an 'AI Readiness' questionnaire.
                Your task is to analyze these answers and generate a 2-3 paragraph 'AI Readiness Report'. 
                This report MUST:
                1. Briefly summarize their current state, using a positive and professional tone (e.g., 'It sounds like you are in the crucial "Exploring" phase...').
                2. Identify 1-2 key opportunity areas based on their goals and data.
                3. Identify 1-2 potential risks or gaps based on their challenges or governance.
                4. Conclude with a strong, clear recommendation for them to book a "Personalized AI Strategy Workshop" or a "1-on-1 Consultation" as the critical next step to build a concrete roadmap and address their specific gaps. Frame this as the logical way to get real results.
                
                Do not use markdown formatting (like * or #). Just write plain text paragraphs.`;

                const payload = {
                    contents: [{ parts: [{ text: prompt }] }],
                    systemInstruction: {
                        parts: [{ text: systemPrompt }]
                    },
                };

                let retries = 3;
                let delay = 1000;
                let response;

                while (retries > 0) {
                    try {
                        response = await fetch(apiUrl, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify(payload)
                        });

                        if (response.ok) {
                            const result = await response.json();
                            const candidate = result.candidates?.[0];
                            if (candidate && candidate.content?.parts?.[0]?.text) {
                                const text = candidate.content.parts[0].text;
                                displayResults(text);
                                return;
                            } else {
                                throw new Error("Invalid response structure from API.");
                            }
                        } else if (response.status === 429 || response.status >= 500) {
                            throw new Error(`APIError: ${response.status}`);
                        } else {
                            const errorResult = await response.json();
                            throw new Error(errorResult.error?.message || "An unknown API error occurred.");
                        }

                    } catch (error) {
                        retries--;
                        if (retries === 0 || !error.message.includes("APIError")) {
                            displayError(error.message);
                            return;
                        }
                        await new Promise(res => setTimeout(res, delay));
                        delay *= 2;
                    }
                }
            };

            const displayResults = (text) => {
                loadingSpinner.classList.add('hidden');
                const reportContent = document.getElementById('report-content');
                reportContent.innerHTML = text.split('\n').map(p => `<p>${p}</p>`).join('');
                resultsDiv.classList.remove('hidden');
                resultsDiv.scrollIntoView({ behavior: 'smooth', block: 'center' });
            };

            const displayError = (errorMessage) => {
                loadingSpinner.classList.add('hidden');
                const reportContent = document.getElementById('report-content');
                reportContent.innerHTML = `<p class="text-red-700">Sorry, an error occurred while generating your report. Please try again later.</p><p class="text-sm text-gray-500">${errorMessage}</p>`;
                resultsDiv.classList.remove('hidden');
                resultsDiv.scrollIntoView({ behavior: 'smooth', block: 'center' });
            };

            document.querySelectorAll('a[href^="#"]').forEach(anchor => {
                anchor.addEventListener('click', function (e) {
                    e.preventDefault();
                    const targetId = this.getAttribute('href');
                    const targetElement = document.querySelector(targetId);
                    if (targetElement) {
                        targetElement.scrollIntoView({
                            behavior: 'smooth'
                        });
                    }
                    if (mobileMenu.classList.contains('hidden') === false) {
                        mobileMenu.classList.add('hidden');
                    }
                });
            });

            mobileMenuBtn.addEventListener('click', () => {
                mobileMenu.classList.toggle('hidden');
            });

            showStep(currentStep);
        });
    </script>
</body>
</html>
